# Copy to .env and fill in. Never commit .env.

# Public URL of THIS voice service (no trailing slash). ElevenLabs calls it.
# After importing the repo on Vercel, set this to https://<project>.vercel.app
# A laptop trial can use an ngrok https origin instead.
TOOL_PUBLIC_BASE_URL=https://your-voice-service.example.com

# Shared secret ElevenLabs sends on every tool call (header x-tool-secret).
TOOL_SHARED_SECRET=replace-with-a-long-random-string
# TOOL_SECRET_HEADER=x-tool-secret

# --- GoCourt (existing API). Ignored while GOCOURT_MOCK=true. ---
# Base URL including the /api prefix. Placeholder only.
GOCOURT_API_BASE_URL=https://api.example.com/api
# Abort one GoCourt HTTP call after this many milliseconds (1000–50000).
# Default is 25000. The Vercel function allows 60s for the whole webhook.
# GOCOURT_REQUEST_TIMEOUT_MS=25000
# Club-owner (or staff) account. Prefer a dedicated staff login.
GOCOURT_OWNER_EMAIL=
GOCOURT_OWNER_PASSWORD=
# Optional: extra headers (JSON object) sent with the login request only, if
# your GoCourt deployment needs them to return a bearer token.
# GOCOURT_LOGIN_HEADERS={"X-Example":"value"}
# Optional: skip login and send this bearer token until it expires.
# GOCOURT_OWNER_TOKEN=
# Optional: which club, when the account can see more than one.
# GOCOURT_CLUB_ID=
# Court timezone. GoCourt uses Europe/Athens; override only if a club differs.
GOCOURT_TIMEZONE=Europe/Athens

# true = in-memory fake GoCourt. No network calls, no real credentials.
GOCOURT_MOCK=true

PORT=8787

# --- ElevenLabs (only for the widget page and scripts/upsert-elevenlabs-agent.ts) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Workspace secret id whose value equals TOOL_SHARED_SECRET. Not the secret itself.
ELEVENLABS_TOOL_SECRET_ID=
