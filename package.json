{
  "name": "gocourt-elevenlabs-agent",
  "version": "1.0.0",
  "description": "ElevenLabs voice receptionist for padel clubs: checks availability, quotes prices and books courts in Greek or English.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.api.json",
    "test": "node --import tsx --test test/*.test.ts",
    "agent:upsert": "tsx scripts/upsert-elevenlabs-agent.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
